<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="aperture-codeartifact" value="https://aperture-678695733480.d.codeartifact.us-east-1.amazonaws.com/nuget/aperture-foundation-sdk/v3/index.json" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="local-sdk" value="C:\LocalNuGet" />
  </packageSources>
  <packageSourceCredentials>
    <aperture-codeartifact>
      <add key="Username" value="aws" />
      <add key="ClearTextPassword" value="%CODEARTIFACT_TOKEN%" />
    </aperture-codeartifact>
  </packageSourceCredentials>
  <packageSourceMapping>
    <packageSource key="aperture-codeartifact">
      <package pattern="Aperture.Platform*" />
    </packageSource>
    <packageSource key="local-sdk">
      <package pattern="Aperture.Platform*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
  <disabledPackageSources>
    <add key="aperture-codeartifact" value="true" />
  </disabledPackageSources>
</configuration>
